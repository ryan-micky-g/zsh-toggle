# Function to toggle between GNU, BSD, and OFF states
#
# *** VERSION WITH SAFETY CHECK - V5 (Three States) ***
#
toggle() {
      # --- START: Safety Interlock ---

      # Convert the current path and the three reference paths into
      # simple, space-delimited strings for comparison.
      local current_path_str="$path"
      local bsd_path_str="$BSDPATH_array"
      local gnu_path_str="$GNUPATH_array"
      local off_path_str="$OFF_array"

      # THE CHECK:
      # If the current path is NOT one of the three known states,
      # then it must be a custom state (like a Venv).
      if [[ "$current_path_str" != "$bsd_path_str" && "$current_path_str" != "$gnu_path_str" && "$current_path_str" != "$off_path_str" ]]; then
            # Abort the function with an error message.
            print -P $'\n%F{red}--- TOGGLE DISABLED ---%f'
            echo "Your PATH is in a custom state (e.g., a Venv is active)."
            echo "Toggle is disabled to prevent breaking your environment."
            print -P $'%F{red}-----------------------%f'
            return 1 # Abort
      fi
      # --- END: Safety Interlock ---

      # Handle explicit 'toggle off' command
      if [[ "$1" == "off" ]]; then
            path=($OFF_array)
            export GNU_UTILS_ACTIVE=-1
            echo "All tools disabled - using minimal system path only"
            return 0
      fi

      # If we made it here, the path is "clean" and we can proceed.
      # If in OFF state, return to GNU; otherwise toggle between GNU and BSD
      if [[ $GNU_UTILS_ACTIVE -eq -1 || $GNU_UTILS_ACTIVE -eq 0 ]]; then
            path=($GNUPATH_array)
            export GNU_UTILS_ACTIVE=1
            echo "GNU utilities enabled"
      else
            path=($BSDPATH_array)
            export GNU_UTILS_ACTIVE=0
            echo "GNU utilities disabled - using macOS default utilities"
      fi
}

# Configure vcs_info for git prompt
autoload -Uz vcs_info
zstyle ':vcs_info:*' enable git
zstyle ':vcs_info:git:*' formats ' %F{green}%b%f '
zstyle ':vcs_info:git:*' actionformats ' %F{green}%b%f %F{red}(%a)%f '

# Update vcs_info before each prompt
precmd_vcs_info() { vcs_info }
precmd_functions+=( precmd_vcs_info )

precmd() {
      # Check for an active Python virtual environment
      if [[ -n "$VIRTUAL_ENV" ]]; then
         # Format the venv name, e.g., "(webui) "
         venv_prompt=" (%F{magenta}$(basename $VIRTUAL_ENV)%f)"
      else
         venv_prompt=""
      fi

      # Check GNU utilities status
      if [[ $GNU_UTILS_ACTIVE -eq 1 ]]; then
         gnu_prompt=$' \uF8FF %F{green}[GNU]%f'
      elif [[ $GNU_UTILS_ACTIVE -eq 0 ]]; then
         gnu_prompt=$' \uF8FF %F{yellow}[BSD]%f'
      else
         gnu_prompt=$' \uF8FF %F{red}[OFF]%f'
      fi

      # Use vcs_info for git branch (already populated by precmd_vcs_info)
      # vcs_info_msg_0_ contains the formatted branch info or empty string
      git_prompt="${vcs_info_msg_0_:- }"

      # Assemble the final prompt
      PS1="${venv_prompt}${gnu_prompt} %F{white} %F{cyan}%~%f${git_prompt}%F{cyan}➜ %f "
}


### Zsh Enhancements ###

# Load Homebrew plugin paths
# (Note: This path is for Apple Silicon. Use /usr/local/share for Intel)
brew_share="/opt/homebrew/share"

# Load Syntax Highlighting (must be loaded relatively early)
if [[ -f "${brew_share}/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
   source "${brew_share}/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi

# Load Autosuggestions (must be loaded AFTER syntax-highlighting)
if [[ -f "${brew_share}/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
   source "${brew_share}/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi

# Initialize the Zsh completion system with lazy-loading
# Only regenerate completions cache once per day
autoload -Uz compinit
if [[ -n ~/.zcompdump(#qN.mh+24) ]]; then
  compinit
else
  compinit -C
fi

# Improve completion behavior
zstyle ':completion:*' menu select # Enable menu selection

