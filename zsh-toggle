# Set history size
HISTSIZE=50000
SAVEHIST=50000
HISTFILE=~/.zsh_history

# History improvements
setopt APPEND_HISTORY  # Appends history to the file, rather than overwriting
setopt SHARE_HISTORY   # Shares history immediately across all running shells
setopt HIST_IGNORE_DUPS # Don't save a command if it's identical to the previous one
setopt HIST_IGNORE_ALL_DUPS # If you type a command, delete older instances of it
setopt HIST_IGNORE_SPACE # Don't save commands that start with a space
setopt HIST_FIND_NO_DUPS # When searching, show the newest entry of a duplicate

# Load aliases
[[ -f ~/.zsh_aliases ]] && source ~/.zsh_aliases

# 1. Define the persistent global variables.
#    These are needed by toggle() and precmd().
typeset -a BSDPATH_array
typeset -a GNUPATH_array
typeset -a OFF_array
export GNU_UTILS_ACTIVE=1 # Set default state (1 = GNU, 0 = BSD, -1 = OFF)

# 2. Define a setup function to populate the global arrays.
#    This keeps temporary variables out of the global scope.
_setup_path_toggle() {
    # Use 'local' to scope these variables *only* to this function.
    
    # Capture the raw system path *before* we add anything
    local -a base_system_path
    base_system_path=($path)

    # Define all our path components
    local -a user_paths=(
      "$HOME/bin"
      "/usr/local/bin"
    )

    local -a brew_paths=(
      "/opt/homebrew/bin"
      "/opt/homebrew/sbin"
    )

    # Hardcoded GNU paths
    local -a gnu_utils_paths=(
      "/opt/homebrew/opt/gpatch/libexec/gnubin"
      "/opt/homebrew/opt/gnu-which/libexec/gnubin"
      "/opt/homebrew/opt/make/libexec/gnubin"
      "/opt/homebrew/opt/gawk/libexec/gnubin"
      "/opt/homebrew/opt/grep/libexec/gnubin"
      "/opt/homebrew/opt/gnu-tar/libexec/gnubin"
      "/opt/homebrew/opt/gnu-sed/libexec/gnubin"
      "/opt/homebrew/opt/findutils/libexec/gnubin"
      "/opt/homebrew/opt/coreutils/libexec/gnubin"
    )

    # --- Populate the global arrays ---

    # 1. Define the BSD path array
    BSDPATH_array=(
      $user_paths
      $brew_paths
      $base_system_path # The original system path
    )

    # 2. Define the GNU path array
    GNUPATH_array=(
      $gnu_utils_paths  # GNU utils go first
      $user_paths
      $brew_paths
      $base_system_path # The original system path
    )

    # 3. Define the OFF path array (no brew, no GNU tools)
    OFF_array=(
      $user_paths
      $base_system_path # The original system path only
    )
    
    # --- Set Default State ---
    # Set the initial path from the default (GNU) array
    path=($GNUPATH_array)
    
    # No 'unset' needed. All 'local' variables are destroyed
    # when this function exits.
}

# 3. Run the setup function once.
_setup_path_toggle

# 4. Clean up the setup function itself so it doesn't pollute the shell
unset -f _setup_path_toggle

